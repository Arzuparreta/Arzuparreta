---
import type { Messages } from '../i18n/types';

interface Props {
	about: Messages['about'];
}

const { about } = Astro.props;
---

<section id="about" class="section" aria-labelledby="about-heading">
	<h2 id="about-heading" data-i18n="about.heading">{about.heading}</h2>
	<div class="about__body">
		<p data-i18n="about.p1">{about.p1}</p>
		<p data-i18n="about.p2">{about.p2}</p>
		<p data-i18n="about.p3">{about.p3}</p>
	</div>
</section>
