---
import type { Messages } from '../i18n/types';

interface Props {
	services: Messages['services'];
	email: string;
}

const { services, email } = Astro.props;

const KEYS = ['infra', 'audit', 'oss'] as const;
---

<section id="services" class="section" aria-labelledby="services-heading">
	<h2 id="services-heading" data-i18n="services.heading">{services.heading}</h2>
	<p class="section__intro" data-i18n="services.intro">{services.intro}</p>
	<div class="services-grid">
		{KEYS.map((key) => (
			<div class="service-card">
				<div class="service-card__header">
					<span class="service-card__title" data-i18n={`services.${key}.title`}>{services[key].title}</span>
				</div>
				<p class="service-card__desc" data-i18n={`services.${key}.desc`}>{services[key].desc}</p>
				<ul class="service-card__bullets">
					<li data-i18n={`services.${key}.bullet1`}>{services[key].bullet1}</li>
					<li data-i18n={`services.${key}.bullet2`}>{services[key].bullet2}</li>
					<li data-i18n={`services.${key}.bullet3`}>{services[key].bullet3}</li>
				</ul>
				<a
					class="btn service-card__cta"
					href={`mailto:${email}?subject=${encodeURIComponent(services[key].ctaSubject)}`}
					data-i18n={`services.${key}.cta`}
				>
					{services[key].cta}
				</a>
			</div>
		))}
	</div>
</section>
